# developer.clashofclans.com se banayi hui key yahan daalo
# Is file ko copy karke .env.local naam do
COC_API_TOKEN=your_key_here

# Optional: proxy use karna ho (jab IP baar-baar badalta ho ya deploy karo)
# COC_API_BASE=https://cocproxy.royaleapi.dev/v1

# Battlelog history save karne ke liye (MongoDB Atlas ya local)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
# MONGODB_DB=coc_lookup

# /api/track ke liye: kaun se players ki battlelog baar-baar save karni hai
TRACK_SECRET=koi_lamba_random_string
TRACK_PLAYER_TAGS=#2PP,#YOURTAG
